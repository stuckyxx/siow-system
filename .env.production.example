# ============================================================================
# Siow System — variáveis de PRODUÇÃO (docker compose -f infra/docker-compose.prod.yml)
# Copie para `.env` na raiz do repositório e preencha TODOS os segredos.
# Gere segredos com:  openssl rand -base64 48
# ============================================================================

# ---------- Domínio / TLS ----------
# Domínio público (DNS A/AAAA apontando para o servidor). O Caddy emite o certificado.
DOMAIN=financeiro.suaempresa.com.br

# ---------- Ambiente ----------
NODE_ENV=production
TZ=America/Sao_Paulo

# ---------- Banco de dados (Postgres interno, sem porta publicada) ----------
POSTGRES_USER=siow
POSTGRES_PASSWORD=TROQUE-openssl-rand-base64-48
POSTGRES_DB=siow_system
# DATABASE_URL é montada automaticamente pelo compose a partir das variáveis acima.

# ---------- Redis (com senha) ----------
REDIS_PASSWORD=TROQUE-openssl-rand-base64-48

# ---------- API ----------
API_PORT=3001
API_URL=https://${DOMAIN}
CORS_ORIGINS=https://${DOMAIN}
JWT_ACCESS_SECRET=TROQUE-openssl-rand-base64-48
JWT_REFRESH_SECRET=TROQUE-openssl-rand-base64-48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_DOMAIN=${DOMAIN}
COOKIE_SECURE=true
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=5

# ---------- Web ----------
# Embutido no build da imagem web (mesma origem: API fica em https://DOMAIN/api)
NEXT_PUBLIC_API_URL=https://${DOMAIN}

# ---------- Armazenamento de objetos (MinIO interno) ----------
S3_REGION=us-east-1
S3_BUCKET=siow-documents
S3_ACCESS_KEY=TROQUE-openssl-rand-base64-24
S3_SECRET_KEY=TROQUE-openssl-rand-base64-48
S3_PRESIGN_TTL_SECONDS=300

# ---------- Sincronização ----------
SYNC_CRON=0 */6 * * *
SYNC_CONCURRENCY=3
SYNC_HTTP_TIMEOUT_MS=20000
SYNC_MAX_ATTEMPTS=4
SYNC_USER_AGENT=SiowSystem/1.0 (+contato@suaempresa.com.br)

# ---------- Certidões / contratos ----------
CERTIFICATE_EXPIRING_DAYS=30
CONTRACT_EXPIRING_DAYS=60

# ---------- Mensageria (opcional) ----------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Financeiro <financeiro@suaempresa.com.br>"

# ---------- Seed inicial (primeiro administrador) ----------
# Em produção o seed RECUSA senha ausente ou com menos de 12 caracteres.
# O administrador é criado com "troca de senha obrigatória" no primeiro login.
SEED_ADMIN_EMAIL=admin@suaempresa.com.br
SEED_ADMIN_PASSWORD=TROQUE-senha-forte-min-12-chars
SEED_ADMIN_NAME=Administrador
