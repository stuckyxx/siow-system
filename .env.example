# ---------- Ambiente ----------
NODE_ENV=development
TZ=America/Sao_Paulo

# ---------- Banco de dados ----------
POSTGRES_USER=gf
POSTGRES_PASSWORD=gf_dev_password
POSTGRES_DB=gestao_financeira
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gf:gf_dev_password@localhost:5432/gestao_financeira?schema=public

# ---------- Redis / filas ----------
REDIS_URL=redis://localhost:6379

# ---------- API ----------
API_PORT=3001
API_URL=http://localhost:3001
# Origem(ns) permitida(s) para CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000
# Segredos: gere com `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_DOMAIN=localhost
# Em produção deve ser "true" (exige TLS)
COOKIE_SECURE=false
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=5

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------- Armazenamento de objetos (S3-compatible) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=gf-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=300

# ---------- Sincronização ----------
# Expressão cron para sincronizar todas as entidades (padrão: a cada 6 horas)
SYNC_CRON=0 */6 * * *
SYNC_CONCURRENCY=3
# Vercel (sem worker): orçamento de tempo por chamada de sync em lote (/api/cron/sync, /api/financeiro/sync/all)
SYNC_BUDGET_MS=45000
# Segredo do cron (Vercel Cron envia "Authorization: Bearer <CRON_SECRET>"; mesmo valor no GitHub Actions)
CRON_SECRET=
SYNC_HTTP_TIMEOUT_MS=20000
SYNC_MAX_ATTEMPTS=4
# Identificação enviada ao portal externo
SYNC_USER_AGENT=GestaoFinanceira/1.0 (+contato@empresa.com.br)

# ---------- Certidões ----------
CERTIFICATE_EXPIRING_DAYS=30
CONTRACT_EXPIRING_DAYS=60

# ---------- Mensageria (opcional) ----------
# WhatsApp Cloud API — deixe vazio para modo "envio manual"
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# SMTP — deixe vazio para modo "envio manual"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Financeiro <financeiro@empresa.com.br>"

# ---------- Seed inicial ----------
SEED_ADMIN_EMAIL=admin@empresa.com.br
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Administrador
