{
  "name": "siow-system",
  "private": true,
  "version": "0.1.0",
  "description": "Siow System — plataforma modular (módulo Financeiro: contratos e recebimentos de órgãos públicos)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:api": "pnpm --filter @siow/api dev",
    "dev:worker": "pnpm --filter @siow/worker dev",
    "dev:web": "pnpm --filter @siow/web dev",
    "build": "pnpm --filter @siow/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @siow/db generate",
    "db:migrate": "pnpm --filter @siow/db migrate:dev",
    "db:deploy": "pnpm --filter @siow/db migrate:deploy",
    "db:seed": "pnpm --filter @siow/db seed",
    "db:studio": "pnpm --filter @siow/db studio",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:push": "pnpm --filter @siow/db push"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma"
    ]
  }
}
