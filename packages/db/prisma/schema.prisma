// =====================================================================
//  Gestão Financeira de Contratos e Recebimentos — modelo de dados
//  Convenções:
//   - Valores monetários: Decimal(14,2)
//   - Datas "de negócio" (competência, vencimento): DateTime @db.Date
//   - Exclusões são LÓGICAS (deletedAt) nos recursos de negócio
//   - Tudo que é crítico gera AuditLog (append-only) e/ou *Event
// =====================================================================

generator client {
  provider      = "prisma-client-js"
  // native = máquina de build/dev; rhel-openssl-3.0.x = runtime das funções Netlify/AWS Lambda (Amazon Linux 2023).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------
//  Usuários, papéis e permissões (RBAC granular)
// ---------------------------------------------------------------------

model User {
  id               String    @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  name             String
  email            String    @unique
  passwordHash     String
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String? // reservado para 2FA (TOTP) — cifrado na aplicação
  /// Obriga a troca de senha no próximo login (ex.: admin criado pelo seed).
  mustChangePassword Boolean @default(false)
  /// Bloqueio por tentativas de login falhas (5 falhas → 15 min).
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  /// 2FA (TOTP): segredo cifrado e data de ativação
  totpSecret       String?
  totpEnabledAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  roles                UserRole[]
  sessions             Session[]
  auditLogs            AuditLog[]
  assignedTasks        FinancialTask[]      @relation("TaskAssignee")
  createdTasks         FinancialTask[]      @relation("TaskCreator")
  responsibleEntities  Entity[]
  ownedOpportunities   Opportunity[]        @relation("OpportunityOwner")
  goals                Goal[]
  partnerProfile       Partner?
  ownedTenders         Tender[]             @relation("TenderOwner")
  responsibleContracts Contract[]
  collectionAttempts   CollectionAttempt[]
  collectionCases      CollectionCase[]
  outboundMessages     OutboundMessage[]
  notifications        Notification[]
  invoiceEvents        InvoiceEvent[]
  overriddenInvoices   Invoice[]            @relation("InvoiceOverriddenBy")
  resolvedConflicts    SyncConflict[]
  syncRuns             SyncRun[]
  uploadedDocuments    Document[]
  taskEvents           TaskEvent[]
  serviceOrderEvents   ServiceOrderEvent[]
  signatureRequests    SignatureRequest[]
  settingsUpdated      Setting[]
  certificateVersions  CertificateVersion[]

  @@index([email])
  @@index([organizationId])
  @@unique([organizationId, email])
  assignedTickets      Ticket[]             @relation("TicketAssignee")
  ticketInteractions   TicketInteraction[]
  waConversations      WaConversation[]    @relation("WaAssignee")
  @@map("users")
  userPermissions UserPermission[]
}

model Role {
  id          String   @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  name        String   // ADMINISTRADOR, FINANCEIRO, GESTOR, CONSULTA, ... (único por organização)
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@index([organizationId])
  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique // ex.: invoices.override
  description String?

  roles RolePermission[]

  @@map("permissions")
  userPermissions UserPermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Sessão = refresh token rotativo (hash) com rastreio de dispositivo.
model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  ip               String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

/// Ajuste individual de permissão (além do papel): granted=true concede, false remove.
model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
}

// ---------------------------------------------------------------------
//  Entidades (clientes públicos) e fontes de dados
// ---------------------------------------------------------------------

enum EntityType {
  PM // Prefeitura Municipal
  CM // Câmara Municipal
  AUTARQUIA
  FUNDO
  INSTITUTO
  CONSORCIO
  OUTRO
}

model Entity {
  id                String     @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  type              EntityType
  name              String // Ex.: "CÂMARA MUNICIPAL DE BOM LUGAR"
  shortName         String? // Ex.: "CM BOM LUGAR"
  municipality      String // Ex.: "Bom Lugar"
  uf                String     @db.Char(2)
  cnpj              String?
  logoUrl           String?
  notes             String?
  isActive          Boolean    @default(true)
  /// Código IBGE do município (7 dígitos) — preenchido pela importação IBGE ou manualmente
  ibgeCode          String?
  /// Segmento comercial: PM, CM, PREVIDENCIA, CONSORCIO, DEFENSORIA, OUTRO (livre para novos)
  segment           String?
  /// Parceiro/representante responsável (FK criada na Fase 4 — Parceiros)
  partnerId         String?
  partner         Partner?   @relation(fields: [partnerId], references: [id])
  /// Saúde do cliente (0–100) calculada no cron diário; null = sem dados suficientes
  healthScore       Int?
  healthUpdatedAt   DateTime?
  responsibleUserId String?
  responsibleUser   User?      @relation(fields: [responsibleUserId], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  dataSources     DataSource[]
  contracts       Contract[]
  invoices        Invoice[]
  contacts        Contact[]
  documents       Document[]
  tasks           FinancialTask[]
  collectionCases CollectionCase[]
  serviceOrders   ServiceOrder[]
  syncRuns        SyncRun[]
  messages        OutboundMessage[]
  notifications   Notification[]
  certificates    Certificate[]
  issuanceAlarms  IssuanceAlarm[]
  publicAgents    PublicAgent[]
  healthSnapshots EntityHealthSnapshot[]
  opportunities   Opportunity[]
  commissions     Commission[]
  tenders         Tender[]

  @@unique([organizationId, type, municipality, uf])
  @@index([municipality])
  @@index([uf])
  @@index([organizationId, ibgeCode])
  @@index([organizationId])
  tickets         Ticket[]
  campaignRecipients CampaignRecipient[]
  waConversations WaConversation[]
  @@map("entities")
}

enum DataSourceProvider {
  ASSESI_PORTAL
  ADOIS_PORTAL // Portal do Cliente da Adois (links de entidade t=1 e de parceiro t=2)
  ASSESI_API
  MANUAL
}

enum SyncStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

/// Uma entidade pode ter uma ou mais fontes (ex.: link do Portal do Cliente).
model DataSource {
  id                  String             @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  entityId            String
  entity              Entity             @relation(fields: [entityId], references: [id], onDelete: Cascade)
  provider            DataSourceProvider @default(ASSESI_PORTAL)
  url                 String
  externalEntityCode  String? // codEntidade no portal (ex.: 12422)
  externalEntityType  String? // tipoEntidade no portal (ex.: 1)
  label               String?
  isActive            Boolean            @default(true)
  syncEnabled         Boolean            @default(true)
  /// Config específica do provider (ex.: {"fetchInvoiceDocuments": false})
  config              Json?
  lastSyncAt          DateTime?
  lastSyncStatus      SyncStatus?
  lastSyncRunId       String?
  lastSuccessAt       DateTime?
  consecutiveFailures Int                @default(0)
  /// Circuit breaker: enquanto no futuro, a fonte não é sincronizada automaticamente.
  circuitOpenUntil    DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  syncRuns SyncRun[]
  invoices Invoice[]

  /// A mesma URL pode servir a várias entidades (link de parceiro da Adois: uma fonte por município, distinguida por `config.entityKey`).
  @@unique([provider, url, entityId])
  @@index([entityId])
  @@index([organizationId])
  @@map("data_sources")
}

enum SyncTrigger {
  SCHEDULED
  MANUAL
  BULK
  RETRY
}

model SyncRun {
  id                String      @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  dataSourceId      String
  dataSource        DataSource  @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  entityId          String
  entity            Entity      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  trigger           SyncTrigger
  status            SyncStatus  @default(QUEUED)
  requestedByUserId String?
  requestedBy       User?       @relation(fields: [requestedByUserId], references: [id])
  jobId             String?
  attempt           Int         @default(1)
  queuedAt          DateTime    @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  durationMs        Int?
  /// Estatísticas: { invoicesSeen, invoicesCreated, invoicesUpdated, statusChanges, certificates, contracts, conflicts, missing }
  stats             Json?
  errorMessage      String?
  errorDetails      String?
  warnings          Json?

  invoiceEvents InvoiceEvent[]
  conflicts     SyncConflict[]

  @@index([dataSourceId, queuedAt])
  @@index([entityId, queuedAt])
  @@index([status])
  @@index([organizationId])
  @@map("sync_runs")
}

// ---------------------------------------------------------------------
//  Contratos e aditivos
// ---------------------------------------------------------------------

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  TERMINATED
}

enum RecordOrigin {
  SYNC
  MANUAL
  IMPORT
  SYSTEM
}

model Contract {
  id                String         @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  entityId          String
  entity            Entity         @relation(fields: [entityId], references: [id], onDelete: Cascade)
  number            String // Ex.: "070201001/2025"
  externalCode      String? // id do contrato no portal (ex.: 20153373)
  object            String?
  description       String?
  monthlyValue      Decimal?       @db.Decimal(14, 2)
  totalValue        Decimal?       @db.Decimal(14, 2)
  startDate         DateTime?      @db.Date
  endDate           DateTime?      @db.Date
  status            ContractStatus @default(ACTIVE)
  /// Se true, o sistema espera uma nota por competência (usado na conta corrente)
  expectsMonthlyBilling Boolean    @default(true)
  responsibleUserId String?
  responsibleUser   User?          @relation(fields: [responsibleUserId], references: [id])
  origin            RecordOrigin   @default(MANUAL)
  notes             String?
  /// Fase 3 — vínculos e ciclo de vida: oportunidade/licitação de origem, parceiro (FK na Fase 4), ativação e encerramento
  opportunityId     String?
  tenderId          String?
  tender            Tender?        @relation(fields: [tenderId], references: [id])
  partnerId         String?
  partner           Partner?       @relation(fields: [partnerId], references: [id])
  renewalNoticeDays Int?
  activatedAt       DateTime?
  terminatedAt      DateTime?      @db.Date
  terminationReason String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  amendments    ContractAmendment[]
  invoices      Invoice[]
  documents     Document[]
  tasks         FinancialTask[]
  serviceOrders ServiceOrder[]
  renewals      ContractRenewal[]
  commissions   Commission[]

  @@unique([entityId, number])
  @@index([entityId])
  @@index([endDate])
  @@index([organizationId])
  tickets           Ticket[]
  @@map("contracts")
}

enum AmendmentKind {
  TERM // prazo/vigência
  VALUE // valor
  OBJECT // objeto
  MIXED
  OTHER
  ADJUSTMENT // reajuste por índice (Fase 3)
  EXTENSION // prorrogação/renovação de vigência (Fase 3)
}

model ContractAmendment {
  id              String        @id @default(uuid())
  contractId      String
  contract        Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  sequence        Int // 1, 2, 3...
  label           String? // Ex.: "6º ADT", "1º Ad"
  kind            AmendmentKind @default(OTHER)
  description     String?
  signedAt        DateTime?     @db.Date
  effectiveFrom   DateTime?     @db.Date
  newEndDate      DateTime?     @db.Date
  newMonthlyValue Decimal?      @db.Decimal(14, 2)
  newObject       String?
  /// Reajuste (Fase 3): índice informado manualmente (IPCA, INPC, IGP-M…) e percentual aplicado
  adjustmentIndex   String?
  adjustmentPercent Decimal?    @db.Decimal(8, 4)
  origin          RecordOrigin  @default(MANUAL)
  documentId      String?
  document        Document?     @relation(fields: [documentId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([contractId, sequence])
  @@map("contract_amendments")
}

// ---------------------------------------------------------------------
//  Notas fiscais, histórico e reconciliação
// ---------------------------------------------------------------------

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
  UNKNOWN
}

model Invoice {
  id              String        @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  entityId        String
  entity          Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  contractId      String?
  contract        Contract?     @relation(fields: [contractId], references: [id])
  dataSourceId    String?
  dataSource      DataSource?   @relation(fields: [dataSourceId], references: [id])
  number          String // Ex.: "50616"
  externalId      String? // id interno no portal (ex.: 64771)
  competenceMonth Int // 1..12
  competenceYear  Int
  amount          Decimal       @db.Decimal(14, 2)
  issueDate       DateTime?     @db.Date
  status          InvoiceStatus @default(UNKNOWN)
  /// Status como veio da fonte (texto original), útil para diagnóstico
  sourceStatusRaw String?
  paidAt          DateTime?     @db.Date
  paidAmount      Decimal?      @db.Decimal(14, 2)
  description     String?
  documentUrl     String? // URL da NF na origem
  receiptUrl      String? // URL do recibo na origem
  origin          RecordOrigin  @default(SYNC)

  // ---- rastreio de presença na fonte ----
  firstSeenAt         DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  missingSince        DateTime?
  needsReconciliation Boolean   @default(false)
  reconciliationNote  String?

  // ---- alteração manual protegida ----
  manualOverride       Boolean   @default(false)
  overrideJustification String?
  overriddenByUserId   String?
  overriddenBy         User?     @relation("InvoiceOverriddenBy", fields: [overriddenByUserId], references: [id])
  overriddenAt         DateTime?

  rawSnapshot Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  events         InvoiceEvent[]
  conflicts      SyncConflict[]
  documents      Document[]
  tasks          FinancialTask[]
  collectionCase CollectionCase?
  messages       OutboundMessage[]
  serviceOrders  ServiceOrder[]

  commissions Commission[]

  @@unique([entityId, number])
  @@index([entityId, status])
  @@index([contractId, competenceYear, competenceMonth])
  @@index([status, issueDate])
  @@index([paidAt])
  @@index([organizationId])
  @@map("invoices")
}

enum InvoiceEventType {
  CREATED
  STATUS_CHANGED
  FIELD_CHANGED
  MISSING_FROM_SOURCE
  REAPPEARED
  MANUAL_OVERRIDE
  RECONCILED
  CONFLICT_DETECTED
  CONFLICT_RESOLVED
  NOTE
}

/// Event log financeiro (append-only): toda mudança relevante de uma nota.
model InvoiceEvent {
  id        String           @id @default(uuid())
  invoiceId String
  invoice   Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type      InvoiceEventType
  field     String?
  oldValue  String?
  newValue  String?
  origin    RecordOrigin
  userId    String?
  user      User?            @relation(fields: [userId], references: [id])
  syncRunId String?
  syncRun   SyncRun?         @relation(fields: [syncRunId], references: [id])
  note      String?
  createdAt DateTime         @default(now())

  @@index([invoiceId, createdAt])
  @@map("invoice_events")
}

enum ConflictStatus {
  OPEN
  KEPT_MANUAL
  ACCEPTED_SOURCE
}

/// Conflito entre valor manual (protegido) e valor vindo da sincronização.
model SyncConflict {
  id               String         @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  invoiceId        String
  invoice          Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  syncRunId        String?
  syncRun          SyncRun?       @relation(fields: [syncRunId], references: [id])
  field            String
  manualValue      String?
  sourceValue      String?
  status           ConflictStatus @default(OPEN)
  resolvedByUserId String?
  resolvedBy       User?          @relation(fields: [resolvedByUserId], references: [id])
  resolvedAt       DateTime?
  resolutionNote   String?
  createdAt        DateTime       @default(now())

  @@index([status])
  @@index([organizationId])
  @@map("sync_conflicts")
}

// ---------------------------------------------------------------------
//  Documentos (armazenamento S3, privado, deduplicado por checksum)
// ---------------------------------------------------------------------

enum DocumentType {
  INVOICE // Nota Fiscal
  SERVICE_REPORT // Relatório de Serviços
  PAYMENT_REQUEST // Solicitação de Pagamento
  LABOR_DECLARATION // Declaração Trabalhista
  RECEIPT // Recibo
  AMENDMENT_REQUEST // Solicitação de Aditivo
  CERTIFICATE // Certidão
  CONTRACT // Contrato
  SERVICE_ORDER // Ordem de Serviço
  SERVICE_ORDER_SIGNED // OS assinada
  TENDER // Edital/anexo/proposta de licitação (Fase 5)
  TICKET // Anexo de chamado de atendimento (Fase 6)
  OTHER
}

/// Conteúdo físico. Documentos idênticos (mesmo checksum) compartilham o blob.
model DocumentBlob {
  id         String   @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  checksum   String   @unique // sha256 hex
  storageKey String   @unique
  size       Int
  mimeType   String
  createdAt  DateTime @default(now())

  documents Document[]

  @@index([organizationId])
  @@map("document_blobs")
}

model Document {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  type             DocumentType
  name             String
  blobId           String
  blob             DocumentBlob @relation(fields: [blobId], references: [id])
  entityId         String?
  entity           Entity?      @relation(fields: [entityId], references: [id])
  contractId       String?
  contract         Contract?    @relation(fields: [contractId], references: [id])
  invoiceId        String?
  invoice          Invoice?     @relation(fields: [invoiceId], references: [id])
  serviceOrderId   String?
  serviceOrder     ServiceOrder? @relation("ServiceOrderDocuments", fields: [serviceOrderId], references: [id])
  tenderId         String?
  tender           Tender?      @relation(fields: [tenderId], references: [id])
  ticketId         String?
  ticket           Ticket?      @relation(fields: [ticketId], references: [id])
  originalUrl      String?
  sourceDate       DateTime?    @db.Date
  capturedAt       DateTime     @default(now())
  uploadedByUserId String?
  uploadedBy       User?        @relation(fields: [uploadedByUserId], references: [id])
  origin           RecordOrigin @default(MANUAL)
  metadata         Json?
  createdAt        DateTime     @default(now())
  deletedAt        DateTime?

  amendments          ContractAmendment[]
  certificateVersions CertificateVersion[]
  mainForServiceOrders ServiceOrder[]      @relation("ServiceOrderMainDocument")
  signedServiceOrders ServiceOrder[]       @relation("ServiceOrderSignedDocument")
  signatureRequests   SignatureRequest[]

  @@index([entityId, type])
  @@index([invoiceId])
  @@index([contractId])
  @@index([organizationId])
  @@map("documents")
}

// ---------------------------------------------------------------------
//  Certidões (com versões/histórico)
// ---------------------------------------------------------------------

model Certificate {
  id        String    @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  /// Chave normalizada do nome (ex.: "certidao-negativa-debitos-trabalhistas")
  slug      String
  name      String
  /// null = certidão da própria empresa (válida para todas as entidades)
  entityId  String?
  entity    Entity?   @relation(fields: [entityId], references: [id])
  isActive  Boolean   @default(true)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  versions CertificateVersion[]

  @@unique([slug, entityId])
  @@index([organizationId])
  @@map("certificates")
}

model CertificateVersion {
  id               String       @id @default(uuid())
  certificateId    String
  certificate      Certificate  @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  externalId       String? // ex.: 1462 (storage/certidoes/1462.pdf)
  sourceUrl        String?
  issuedAt         DateTime?    @db.Date
  validUntil       DateTime?    @db.Date
  documentId       String?
  document         Document?    @relation(fields: [documentId], references: [id])
  capturedAt       DateTime     @default(now())
  origin           RecordOrigin @default(SYNC)
  registeredByUserId String?
  registeredBy     User?        @relation(fields: [registeredByUserId], references: [id])
  isCurrent        Boolean      @default(true)

  @@index([certificateId, isCurrent])
  @@index([validUntil])
  @@map("certificate_versions")
}

// ---------------------------------------------------------------------
//  Contatos
// ---------------------------------------------------------------------

model Contact {
  id          String    @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  entityId    String
  entity      Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name        String
  role        String? // cargo
  department  String? // setor
  phone       String?
  whatsapp    String?
  email       String?
  notes       String?
  isPrimary   Boolean   @default(false)
  isFinancial Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  collectionAttempts CollectionAttempt[]
  messages           OutboundMessage[]

  @@index([entityId])
  @@index([organizationId])
  tickets            Ticket[]
  ticketInteractions TicketInteraction[]
  campaignRecipients CampaignRecipient[]
  waConversations    WaConversation[]
  @@map("contacts")
}

// ---------------------------------------------------------------------
//  Agenda financeira (tarefas)
// ---------------------------------------------------------------------

enum TaskType {
  CHARGE_CLIENT // cobrar município
  CHARGE_AGAIN // cobrar novamente
  VERIFY_PAYMENT // verificar pagamento
  REQUEST_SERVICE_ORDER // solicitar ordem de serviço
  VERIFY_SIGNATURE // verificar assinatura
  RENEW_CERTIFICATE // renovar certidão
  VERIFY_CONTRACT // verificar contrato
  SEND_DOCUMENT // enviar documento
  CONFIRM_PAYMENT // confirmar pagamento
  COMMERCIAL_FOLLOWUP // retorno comercial
  VISIT // visita
  MEETING // reunião
  CALL // ligação
  RENEWAL // renovação de contrato
  UPDATE_CONTACTS // atualizar contatos (troca de gestão)
  CUSTOM
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

model FinancialTask {
  id              String        @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  title           String
  description     String?
  type            TaskType      @default(CUSTOM)
  entityId        String?
  entity          Entity?       @relation(fields: [entityId], references: [id])
  contractId      String?
  contract        Contract?     @relation(fields: [contractId], references: [id])
  invoiceId       String?
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])
  serviceOrderId  String?
  serviceOrder    ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  /// Agenda única: módulo de origem (FINANCEIRO, COMERCIAL, LICITACOES, CONTRATOS, ATENDIMENTO) e vínculos dos módulos futuros
  module          String        @default("FINANCEIRO")
  opportunityId   String?
  opportunity     Opportunity?  @relation(fields: [opportunityId], references: [id])
  tenderId        String?
  tender          Tender?       @relation(fields: [tenderId], references: [id])
  ticketId        String?
  ticket          Ticket?       @relation(fields: [ticketId], references: [id])
  assigneeUserId  String?
  assignee        User?         @relation("TaskAssignee", fields: [assigneeUserId], references: [id])
  createdByUserId String?
  createdBy       User?         @relation("TaskCreator", fields: [createdByUserId], references: [id])
  priority        TaskPriority  @default(MEDIUM)
  status          TaskStatus    @default(PENDING)
  dueDate         DateTime      @db.Date
  dueTime         String? // "HH:mm" opcional
  notes           String?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  events TaskEvent[]

  @@index([assigneeUserId, status, dueDate])
  @@index([entityId, dueDate])
  @@index([dueDate])
  @@index([organizationId])
  @@index([opportunityId])
  @@map("financial_tasks")
}

model TaskEvent {
  id        String        @id @default(uuid())
  taskId    String
  task      FinancialTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  action    String // CREATED, STATUS_CHANGED, REASSIGNED, RESCHEDULED, COMMENT, ...
  fromValue String?
  toValue   String?
  note      String?
  createdAt DateTime      @default(now())

  @@index([taskId, createdAt])
  @@map("task_events")
}

// ---------------------------------------------------------------------
//  Cobranças (separadas do status da nota)
// ---------------------------------------------------------------------

enum CollectionStatus {
  NOT_CHARGED
  SCHEDULED
  SENT
  CLIENT_REPLIED
  PAYMENT_PROMISED
  AWAITING_PAYMENT
  SETTLED
}

enum MessageChannel {
  WHATSAPP
  EMAIL
  PHONE
  IN_PERSON
  OTHER
}

model CollectionCase {
  id                  String           @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  invoiceId           String           @unique
  invoice             Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  entityId            String
  entity              Entity           @relation(fields: [entityId], references: [id], onDelete: Cascade)
  status              CollectionStatus @default(NOT_CHARGED)
  assigneeUserId      String?
  assignee            User?            @relation(fields: [assigneeUserId], references: [id])
  nextActionAt        DateTime?        @db.Date
  nextActionNote      String?
  promisedPaymentDate DateTime?        @db.Date
  lastAttemptAt       DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  attempts CollectionAttempt[]

  @@index([entityId, status])
  @@index([nextActionAt])
  @@index([organizationId])
  @@map("collection_cases")
}

model CollectionAttempt {
  id                String           @id @default(uuid())
  caseId            String
  case              CollectionCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  performedByUserId String?
  performedBy       User?            @relation(fields: [performedByUserId], references: [id])
  performedAt       DateTime         @default(now())
  channel           MessageChannel
  contactId         String?
  contact           Contact?         @relation(fields: [contactId], references: [id])
  message           String?
  response          String?
  resultingStatus   CollectionStatus
  nextActionAt      DateTime?        @db.Date
  nextActionNote    String?
  messageId         String?          @unique
  outboundMessage   OutboundMessage? @relation(fields: [messageId], references: [id])
  createdAt         DateTime         @default(now())

  @@index([caseId, performedAt])
  @@map("collection_attempts")
}

// ---------------------------------------------------------------------
//  Mensagens e templates
// ---------------------------------------------------------------------

model MessageTemplate {
  id          String          @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  key         String          // ex.: SERVICE_ORDER_ISSUE_REMINDER (único por organização)
  name        String
  channel     MessageChannel? // null = qualquer canal
  subject     String?
  body        String
  /// Lista de variáveis suportadas: ["entidade","competencia","exercicio",...]
  variables   Json?
  isActive    Boolean         @default(true)
  isSystem    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  messages OutboundMessage[]

  @@index([organizationId])
  @@unique([organizationId, key])
  @@map("message_templates")
}

enum OutboundMessageStatus {
  DRAFT
  MANUAL_PENDING // gerada para envio manual (sem provedor configurado)
  MANUALLY_CONFIRMED // usuário confirmou que enviou manualmente
  QUEUED
  SENT // provedor aceitou
  DELIVERED // provedor confirmou entrega
  FAILED
}

model OutboundMessage {
  id                String                @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  channel           MessageChannel
  templateId        String?
  template          MessageTemplate?      @relation(fields: [templateId], references: [id])
  entityId          String?
  entity            Entity?               @relation(fields: [entityId], references: [id])
  contactId         String?
  contact           Contact?              @relation(fields: [contactId], references: [id])
  invoiceId         String?
  invoice           Invoice?              @relation(fields: [invoiceId], references: [id])
  serviceOrderId    String?
  serviceOrder      ServiceOrder?         @relation(fields: [serviceOrderId], references: [id])
  ticketId          String?
  ticket            Ticket?               @relation(fields: [ticketId], references: [id])
  recipient         String // telefone/e-mail de destino
  subject           String?
  body              String
  status            OutboundMessageStatus @default(DRAFT)
  providerName      String? // whatsapp-cloud, smtp, manual
  providerMessageId String?
  providerResponse  Json?
  errorMessage      String?
  sentByUserId      String?
  sentBy            User?                 @relation(fields: [sentByUserId], references: [id])
  sentAt            DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  collectionAttempt CollectionAttempt?

  @@index([entityId, createdAt])
  @@index([organizationId])
  campaignRecipient CampaignRecipient?
  @@map("outbound_messages")
}

// ---------------------------------------------------------------------
//  Ordens de serviço e assinatura
// ---------------------------------------------------------------------

enum ServiceOrderStatus {
  NOT_REQUESTED
  REQUESTED
  AWAITING_ISSUE
  ISSUED
  AWAITING_SIGNATURE
  SIGNED
  CANCELLED
}

model ServiceOrder {
  id               String             @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  entityId         String
  entity           Entity             @relation(fields: [entityId], references: [id], onDelete: Cascade)
  contractId       String
  contract         Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  invoiceId        String?
  invoice          Invoice?           @relation(fields: [invoiceId], references: [id])
  competenceMonth  Int
  competenceYear   Int
  number           String?
  status           ServiceOrderStatus @default(NOT_REQUESTED)
  requestedAt      DateTime?          @db.Date
  issuedAt         DateTime?          @db.Date
  signedAt         DateTime?          @db.Date
  documentId       String?
  document         Document?          @relation("ServiceOrderMainDocument", fields: [documentId], references: [id])
  signedDocumentId String?
  signedDocument   Document?          @relation("ServiceOrderSignedDocument", fields: [signedDocumentId], references: [id])
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  signatories       ServiceOrderSignatory[]
  events            ServiceOrderEvent[]
  signatureRequests SignatureRequest[]
  tasks             FinancialTask[]
  messages          OutboundMessage[]
  documents         Document[]          @relation("ServiceOrderDocuments")

  @@unique([contractId, competenceYear, competenceMonth])
  @@index([entityId, status])
  @@index([organizationId])
  @@map("service_orders")
}

model ServiceOrderSignatory {
  id             String       @id @default(uuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  name           String
  role           String?
  email          String?
  signedAt       DateTime?
  createdAt      DateTime     @default(now())

  @@map("service_order_signatories")
}

model ServiceOrderEvent {
  id             String       @id @default(uuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  action         String
  fromValue      String?
  toValue        String?
  note           String?
  createdAt      DateTime     @default(now())

  @@index([serviceOrderId, createdAt])
  @@map("service_order_events")
}

enum SignatureProvider {
  MANUAL_UPLOAD
  CLICKSIGN
  DOCUSIGN
  GOV_BR
  OTHER
}

enum SignatureRequestStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  DECLINED
  EXPIRED
  CANCELLED
  COMPLETED_MANUALLY
}

model SignatureRequest {
  id                 String                 @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  serviceOrderId     String
  serviceOrder       ServiceOrder           @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  provider           SignatureProvider
  providerRequestId  String?
  status             SignatureRequestStatus @default(DRAFT)
  sentAt             DateTime?
  completedAt        DateTime?
  signedDocumentId   String?
  signedDocument     Document?              @relation(fields: [signedDocumentId], references: [id])
  /// Evidências do provedor (IPs, hashes, timestamps, certificado) ou do registro manual
  evidence           Json?
  registeredByUserId String?
  registeredBy       User?                  @relation(fields: [registeredByUserId], references: [id])
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([serviceOrderId])
  @@index([organizationId])
  @@map("signature_requests")
}

// ---------------------------------------------------------------------
//  Auditoria (append-only), notificações e configurações
// ---------------------------------------------------------------------

/// Nunca é editado/apagado pela aplicação (ver migration com REVOKE).
model AuditLog {
  id            String   @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  action        String // CREATE, UPDATE, SOFT_DELETE, STATUS_OVERRIDE, LOGIN, EXPORT, DOWNLOAD, ...
  resource      String // invoice, contract, entity, ...
  resourceId    String?
  before        Json?
  after         Json?
  justification String?
  ip            String?
  userAgent     String?
  requestId     String?
  createdAt     DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([resource, resourceId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

enum NotificationType {
  CERTIFICATE_EXPIRING
  CERTIFICATE_EXPIRED
  CONTRACT_EXPIRING
  INVOICE_OVERDUE
  SYNC_FAILED
  RECONCILIATION_NEEDED
  TASK_DUE
  SERVICE_ORDER_PENDING
  ISSUANCE_DUE
  OPPORTUNITY_STALLED
  TENDER_DEADLINE
  TICKET_SLA
  GENERIC
}

/// Alarme de emissão: dia do mês em que a nota da entidade deve ser emitida; o sistema avisa `leadDays` antes.
model IssuanceAlarm {
  id              String    @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  entityId        String
  entity          Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  /// Contrato a que o alarme se refere (opcional; texto livre do número para não depender da sincronização)
  contractNumber  String?
  label           String    @default("Emissão da nota")
  dayOfMonth      Int
  leadDays        Int       @default(5)
  isActive        Boolean   @default(true)
  notes           String?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([entityId])
  @@index([organizationId])
  @@map("issuance_alarms")
}

/// Organização (tenant): na Edição Própria existe uma só (Siow System Tecnologia); no SaaS, uma por cliente.
model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  document  String? // CNPJ
  plan      String    @default("PROPRIA") // PROPRIA | SAAS_BASICO | SAAS_PRO ...
  /// Módulos habilitados (ex.: ["FINANCEIRO","CADASTRO","COMERCIAL"]); vazio = todos
  modules   Json      @default("[]")
  /// Marca: { productName, logoUrl, accent, accent2, domain }
  branding  Json      @default("{}")
  locale    String    @default("pt-BR")
  status    String    @default("ACTIVE") // ACTIVE | SUSPENDED | READONLY
  /// Limites do plano (sobrescrevem o plano): { maxUsers, maxEntities }
  limits    Json      @default("{}")
  /// Domínio próprio (white-label): resolve marca e login por host
  domain    String?   @unique
  trialEndsAt DateTime?
  blockedAt   DateTime?
  blockReason String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users            User[]
  roles            Role[]
  entities         Entity[]
  dataSources      DataSource[]
  syncRuns         SyncRun[]
  contracts        Contract[]
  invoices         Invoice[]
  syncConflicts    SyncConflict[]
  documentBlobs    DocumentBlob[]
  documents        Document[]
  certificates     Certificate[]
  contacts         Contact[]
  tasks            FinancialTask[]
  collectionCases  CollectionCase[]
  messageTemplates MessageTemplate[]
  outboundMessages OutboundMessage[]
  serviceOrders    ServiceOrder[]
  signatureRequests SignatureRequest[]
  issuanceAlarms   IssuanceAlarm[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  publicAgents     PublicAgent[]
  healthSnapshots  EntityHealthSnapshot[]
  pipelines        Pipeline[]
  pipelineStages   PipelineStage[]
  opportunities    Opportunity[]
  opportunityItems OpportunityItem[]
  proposals        Proposal[]
  catalogItems     CatalogItem[]
  goals            Goal[]
  contractRenewals ContractRenewal[]
  partners         Partner[]
  commissionRules  CommissionRule[]
  commissions      Commission[]
  tenders          Tender[]

  tickets          Ticket[]
  campaigns        Campaign[]
  integrations     Integration[]
  integrationLogs  IntegrationLog[]
  webhooks         Webhook[]
  waConversations  WaConversation[]
  settings         Setting[]
  subscription     Subscription?
  subscriptionInvoices SubscriptionInvoice[]
  apiKeys          ApiKey[]
  assistantConversations AssistantConversation[]
  municipalityStatuses   MunicipalityStatus[]
  @@map("organizations")
}

/// Administrador da plataforma (Siow) — fora das organizações; usado pelo superadmin do SaaS (Fase 9).
model PlatformAdmin {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  totpSecret   String?
  totpEnabledAt DateTime?
  createdAt    DateTime  @default(now())

  @@map("platform_admins")
}

/// Fase 9 — SaaS: planos (licenciamento por módulo e limites), assinaturas e faturas da plataforma, chaves de API por organização.
model Plan {
  key          String   @id // PROPRIA | SAAS_BASICO | SAAS_PRO | …
  name         String
  description  String?
  priceMonthly Decimal  @db.Decimal(12, 2) @default(0)
  maxUsers     Int?
  maxEntities  Int?
  /// Módulos licenciados (vazio = todos)
  modules      Json     @default("[]")
  trialDays    Int      @default(14)
  isActive     Boolean  @default(true)
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("plans")
}

model Subscription {
  id                 String       @id @default(uuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id])
  planKey            String
  status             String       @default("TRIAL") // TRIAL | ACTIVE | PAST_DUE | BLOCKED | CANCELLED | EXEMPT
  amount             Decimal      @db.Decimal(12, 2) @default(0)
  billingDay         Int          @default(10)
  graceDays          Int          @default(10)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?    @db.Date
  currentPeriodEnd   DateTime?    @db.Date
  cancelledAt        DateTime?
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("subscriptions")
}

model SubscriptionInvoice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  period         String // "2026-10"
  amount         Decimal      @db.Decimal(12, 2)
  dueDate        DateTime     @db.Date
  status         String       @default("OPEN") // OPEN | PAID | OVERDUE | CANCELLED
  paidAt         DateTime?    @db.Date
  paymentRef     String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, period])
  @@index([status, dueDate])
  @@map("subscription_invoices")
}

/// Fase 15 — situação comercial manual por município (Mapa de cobertura). "Cliente ativo" é calculado
/// pelos contratos ativos das entidades com o mesmo código IBGE; aqui ficam implantação, negociação e "sem atuação".
model MunicipalityStatus {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  ibgeCode        String       @db.Char(7)
  uf              String       @db.Char(2)
  /// IMPLANTACAO | NEGOCIACAO | NENHUMA
  status          String
  notes           String?
  updatedByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, ibgeCode])
  @@map("municipality_statuses")
}

/// Fase 13 — conversas do Assistente virtual (histórico por usuário).
model AssistantConversation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  title          String
  /// [{ role: 'user'|'assistant', content, steps?, at }]
  messages       Json         @default("[]")
  messageCount   Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([organizationId, userId, updatedAt])
  @@map("assistant_conversations")
}

model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  prefix         String // primeiros caracteres para identificação
  keyHash        String       @unique
  permissions    Json         @default("[]")
  isActive       Boolean      @default(true)
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdByUserId String?
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?

  @@index([organizationId])
  @@map("api_keys")
}

/// Agente público (prefeito, presidente da câmara, secretário, controlador, contador, pregoeiro…) com mandato.
model PublicAgent {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  entityId        String
  entity          Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name            String
  position        String // cargo
  party           String?
  termStart       DateTime?    @db.Date
  termEnd         DateTime?    @db.Date
  email           String?
  phone           String?
  whatsapp        String?
  isDecisionMaker Boolean      @default(false)
  isActive        Boolean      @default(true)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  @@index([organizationId])
  @@index([entityId])
  @@map("public_agents")
}

/// Histórico diário da saúde do cliente (uma linha por entidade e dia).
model EntityHealthSnapshot {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  entityId       String
  entity         Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  score          Int?
  /// Fatores que compuseram a nota (para explicar na interface)
  factors        Json
  createdAt      DateTime     @default(now())

  @@unique([entityId, date])
  @@index([organizationId, date])
  @@map("entity_health_snapshots")
}

model Notification {
  id            String           @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  userId        String? // null = para toda a equipe
  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  body          String?
  entityId      String?
  entity        Entity?          @relation(fields: [entityId], references: [id])
  referenceType String?
  referenceId   String?
  /// Chave de deduplicação (ex.: CERTIFICATE_EXPIRING:<versionId>)
  dedupeKey     String?          @unique
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  @@index([userId, readAt])
  @@index([organizationId])
  @@map("notifications")
}

model Setting {
  organizationId  String       @default("7a1b5c3e-5e1f-4a4e-8c0d-000000000001")
  organization    Organization @relation(fields: [organizationId], references: [id])
  key             String
  value           Json
  description     String?
  updatedByUserId String?
  updatedBy       User?        @relation(fields: [updatedByUserId], references: [id])
  updatedAt       DateTime     @updatedAt

  @@id([organizationId, key])
  @@map("settings")
}

// =====================================================================
// FASE 2 — CRM COMERCIAL (módulo 2): funil, oportunidades, propostas, catálogo, metas
// =====================================================================

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

/// Funil de vendas (configurável por organização; um padrão por organização).
model Pipeline {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  isDefault      Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  stages        PipelineStage[]
  opportunities Opportunity[]

  @@index([organizationId])
  @@map("pipelines")
}

/// Etapa do funil. kind: OPEN (em andamento), WON (ganho), LOST (perdido). slaDays: dias sem movimentação para alertar.
model PipelineStage {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  pipelineId     String
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name           String
  position       Int
  probability    Int          @default(0) // 0–100 (%)
  kind           String       @default("OPEN") // OPEN | WON | LOST
  slaDays        Int?
  color          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  opportunities Opportunity[]

  @@index([pipelineId, position])
  @@index([organizationId])
  @@map("pipeline_stages")
}

/// Oportunidade comercial (lead → ... → ganho/perdido). Valores: mensal (recorrente) e único; total = mensal × prazo + único.
model Opportunity {
  id                String            @id @default(uuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id])
  entityId          String
  entity            Entity            @relation(fields: [entityId], references: [id], onDelete: Cascade)
  pipelineId        String
  pipeline          Pipeline          @relation(fields: [pipelineId], references: [id])
  stageId           String
  stage             PipelineStage     @relation(fields: [stageId], references: [id])
  title             String
  description       String?
  monthlyAmount     Decimal?          @db.Decimal(14, 2)
  oneTimeAmount     Decimal?          @db.Decimal(14, 2)
  termMonths        Int?
  totalAmount       Decimal?          @db.Decimal(14, 2)
  probability       Int? // sobrescreve a da etapa quando informado
  expectedCloseDate DateTime?         @db.Date
  status            OpportunityStatus @default(OPEN)
  source            String? // INDICACAO, PROSPECCAO, LICITACAO, RENOVACAO, PARCEIRO, OUTRO
  ownerUserId       String?
  owner             User?             @relation("OpportunityOwner", fields: [ownerUserId], references: [id])
  partnerId         String?
  partner           Partner?          @relation(fields: [partnerId], references: [id])
  lostReason        String?
  lostNotes         String?
  wonAt             DateTime?
  lostAt            DateTime?
  /// Contrato criado na formalização (Fase 2 cria em rascunho; nunca ativo sem confirmação)
  contractId        String?
  stageEnteredAt    DateTime          @default(now())
  lastActivityAt    DateTime?
  createdByUserId   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  items     OpportunityItem[]
  events    OpportunityEvent[]
  proposals Proposal[]
  tasks     FinancialTask[]
  tenders   Tender[]

  @@index([organizationId, status])
  @@index([entityId])
  @@index([stageId])
  @@index([ownerUserId])
  @@index([expectedCloseDate])
  tickets   Ticket[]
  @@map("opportunities")
}

/// Item da oportunidade (produto/serviço do catálogo ou livre). recurrence: MONTHLY | ONE_TIME | YEARLY
model OpportunityItem {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  opportunityId  String
  opportunity    Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  catalogItemId  String?
  catalogItem    CatalogItem? @relation(fields: [catalogItemId], references: [id])
  description    String
  quantity       Decimal      @default(1) @db.Decimal(12, 2)
  unitPrice      Decimal      @db.Decimal(14, 2)
  recurrence     String       @default("MONTHLY")
  total          Decimal      @db.Decimal(14, 2)
  position       Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([opportunityId])
  @@index([organizationId])
  @@map("opportunity_items")
}

/// Histórico da oportunidade (criação, mudança de etapa, valor, responsável, ganho, perda, proposta, atividade).
model OpportunityEvent {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId        String?
  action        String
  fromValue     String?
  toValue       String?
  notes         String?
  createdAt     DateTime    @default(now())

  @@index([opportunityId, createdAt])
  @@map("opportunity_events")
}

/// Proposta comercial versionada (uma oportunidade pode ter várias versões; a mais recente é a vigente).
model Proposal {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  opportunityId   String
  opportunity     Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  version         Int
  title           String
  status          String       @default("DRAFT") // DRAFT | SENT | ACCEPTED | REJECTED | SUPERSEDED
  validUntil      DateTime?    @db.Date
  introduction    String?
  terms           String?
  notes           String?
  totalMonthly    Decimal      @default(0) @db.Decimal(14, 2)
  totalOneTime    Decimal      @default(0) @db.Decimal(14, 2)
  sentAt          DateTime?
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items ProposalItem[]

  @@unique([opportunityId, version])
  @@index([organizationId])
  @@map("proposals")
}

model ProposalItem {
  id          String   @id @default(uuid())
  proposalId  String
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(14, 2)
  recurrence  String   @default("MONTHLY")
  total       Decimal  @db.Decimal(14, 2)
  position    Int      @default(0)

  @@index([proposalId])
  @@map("proposal_items")
}

/// Catálogo de produtos e serviços da organização.
model CatalogItem {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String?
  name           String
  description    String?
  category       String?
  unitPrice      Decimal      @db.Decimal(14, 2)
  recurrence     String       @default("MONTHLY")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  opportunityItems OpportunityItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("catalog_items")
}

/// Meta comercial por período: individual (userId) ou da equipe (userId nulo). metric: WON_AMOUNT | WON_COUNT | ACTIVITIES
model Goal {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  metric         String       @default("WON_AMOUNT")
  periodStart    DateTime     @db.Date
  periodEnd      DateTime     @db.Date
  target         Decimal      @db.Decimal(14, 2)
  label          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, periodStart])
  @@map("goals")
}

// =====================================================================
// FASE 3 — GESTÃO DE CONTRATOS: renovações (geradas automaticamente, decididas por pessoas)
// =====================================================================

/// Ciclo de renovação de um contrato: criado pelo cron quando a vigência entra na janela (contracts.renewalDays),
/// com oportunidade (origem RENOVACAO) e tarefa RENEWAL. status: OPEN | RENEWED | NOT_RENEWED | CANCELLED.
model ContractRenewal {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  contractId       String
  contract         Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  endDate          DateTime     @db.Date
  status           String       @default("OPEN")
  opportunityId    String?
  taskId           String?
  amendmentId      String?
  newContractId    String?
  notes            String?
  decidedAt        DateTime?
  decidedByUserId  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([contractId, endDate])
  @@index([organizationId, status])
  @@map("contract_renewals")
}

// =====================================================================
// FASE 4 — PARCEIROS E COMISSÕES (módulo 7)
// =====================================================================

/// Parceiro/representante/indicador. `userId` liga ao login do portal do parceiro (papel PARCEIRO, escopo restrito).
model Partner {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  kind           String       @default("REPRESENTANTE") // REPRESENTANTE | INDICADOR | EMPRESA
  document       String? // CPF/CNPJ
  contactName    String?
  email          String?
  phone          String?
  whatsapp       String?
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id])
  bankInfo       String?
  notes          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  entities      Entity[]
  contracts     Contract[]
  opportunities Opportunity[]
  rules         CommissionRule[]
  commissions   Commission[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("partners")
}

/// Regra de remuneração. basis: RECEIVED (sobre recebimento confirmado) | INVOICED (sobre faturamento).
/// Escopo: entidade e/ou contrato específicos, ou (ambos nulos) todas as entidades/contratos vinculados ao parceiro.
/// maxMonths limita a quantas competências (desde o início do contrato) a comissão se aplica.
model CommissionRule {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  partnerId      String
  partner        Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name           String
  basis          String       @default("RECEIVED")
  percent        Decimal      @db.Decimal(7, 4)
  entityId       String?
  contractId     String?
  startDate      DateTime?    @db.Date
  endDate        DateTime?    @db.Date
  maxMonths      Int?
  isActive       Boolean      @default(true)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  commissions Commission[]

  @@index([organizationId, partnerId])
  @@map("commission_rules")
}

/// Comissão calculada por nota (única por regra + nota). status: FORECAST (nota emitida, não paga) | DUE (recebimento confirmado,
/// a pagar ao parceiro) | PAID (paga ao parceiro) | REVERSED (nota cancelada/voltou a pendente depois de DUE/PAID).
model Commission {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  partnerId       String
  partner         Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  ruleId          String
  rule            CommissionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  entityId        String
  entity          Entity         @relation(fields: [entityId], references: [id], onDelete: Cascade)
  contractId      String?
  contract        Contract?      @relation(fields: [contractId], references: [id])
  competenceYear  Int
  competenceMonth Int
  baseAmount      Decimal        @db.Decimal(14, 2)
  percent         Decimal        @db.Decimal(7, 4)
  amount          Decimal        @db.Decimal(14, 2)
  status          String         @default("FORECAST")
  dueAt           DateTime?      @db.Date
  paidAt          DateTime?      @db.Date
  paidByUserId    String?
  paymentRef      String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([ruleId, invoiceId])
  @@index([organizationId, partnerId, status])
  @@index([invoiceId])
  @@map("commissions")
}

// =====================================================================
// FASE 5 — LICITAÇÕES E CONTRATAÇÕES (módulo 3)
// =====================================================================

/// Processo licitatório. officialId = identificador oficial (ex.: número de controle PNCP) — único por organização contra duplicidade.
model Tender {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  entityId         String
  entity           Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  opportunityId    String?
  opportunity      Opportunity? @relation(fields: [opportunityId], references: [id])
  modality         String       @default("PREGAO_ELETRONICO")
  number           String
  year             Int?
  officialId       String?
  object           String
  status           String       @default("IDENTIFIED")
  estimatedValue   Decimal?     @db.Decimal(14, 2)
  ourProposalValue Decimal?     @db.Decimal(14, 2)
  winnerValue      Decimal?     @db.Decimal(14, 2)
  publishedAt      DateTime?    @db.Date
  proposalDeadline DateTime?
  sessionAt        DateTime?
  resultAt         DateTime?    @db.Date
  homologatedAt    DateTime?    @db.Date
  portalUrl        String?
  source           String       @default("MANUAL") // MANUAL | PNCP | PLANILHA
  ownerUserId      String?
  owner            User?        @relation("TenderOwner", fields: [ownerUserId], references: [id])
  lossReason       String?
  notes            String?
  createdByUserId  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  deadlines   TenderDeadline[]
  competitors TenderCompetitor[]
  checklist   TenderChecklistItem[]
  events      TenderEvent[]
  documents   Document[]
  contracts   Contract[]
  tasks       FinancialTask[]

  @@unique([organizationId, officialId])
  @@index([organizationId, status])
  @@index([entityId])
  @@index([sessionAt])
  tickets     Ticket[]
  @@map("tenders")
}

/// Prazo do processo (impugnação, esclarecimentos, proposta, sessão, recurso, resultado, homologação, assinatura…).
model TenderDeadline {
  id        String   @id @default(uuid())
  tenderId  String
  tender    Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  kind      String   @default("OTHER")
  title     String
  dueAt     DateTime
  done      Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenderId, dueAt])
  @@index([dueAt])
  @@map("tender_deadlines")
}

model TenderCompetitor {
  id            String   @id @default(uuid())
  tenderId      String
  tender        Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  name          String
  document      String?
  proposalValue Decimal? @db.Decimal(14, 2)
  rank          Int?
  isWinner      Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())

  @@index([tenderId])
  @@map("tender_competitors")
}

/// Checklist de habilitação: item livre ou ligado a uma certidão (situação calculada pela validade na data da sessão).
model TenderChecklistItem {
  id            String   @id @default(uuid())
  tenderId      String
  tender        Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  title         String
  certificateId String?
  documentId    String?
  required      Boolean  @default(true)
  done          Boolean  @default(false)
  position      Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenderId])
  @@map("tender_checklist_items")
}

model TenderEvent {
  id        String   @id @default(uuid())
  tenderId  String
  tender    Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  userId    String?
  action    String
  fromValue String?
  toValue   String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([tenderId, createdAt])
  @@map("tender_events")
}

/// Fase 6 — Atendimento: chamado/ticket (suporte, comercial, financeiro, visita, reunião…). Número sequencial por organização.
model Ticket {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  number             Int
  entityId           String?
  entity             Entity?      @relation(fields: [entityId], references: [id])
  contactId          String?
  contact            Contact?     @relation(fields: [contactId], references: [id])
  contractId         String?
  contract           Contract?    @relation(fields: [contractId], references: [id])
  opportunityId      String?
  opportunity        Opportunity? @relation(fields: [opportunityId], references: [id])
  tenderId           String?
  tender             Tender?      @relation(fields: [tenderId], references: [id])
  type               String       @default("REQUEST") // SUPPORT | COMMERCIAL | FINANCIAL | REQUEST | COMPLAINT | VISIT | MEETING | OTHER
  channel            String       @default("OTHER") // WHATSAPP | EMAIL | PHONE | IN_PERSON | PORTAL | OTHER
  priority           String       @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status             String       @default("OPEN") // OPEN | IN_PROGRESS | WAITING_CLIENT | WAITING_INTERNAL | RESOLVED | CLOSED | CANCELLED
  subject            String
  description        String?
  requesterName      String?
  assigneeUserId     String?
  assignee           User?        @relation("TicketAssignee", fields: [assigneeUserId], references: [id])
  createdByUserId    String?
  openedAt           DateTime     @default(now())
  firstResponseDueAt DateTime?
  resolutionDueAt    DateTime?
  firstResponseAt    DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  lastActivityAt     DateTime     @default(now())
  resolutionNotes    String?
  satisfactionToken  String?      @unique
  satisfactionScore  Int?
  satisfactionComment String?
  satisfactionAt     DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  interactions TicketInteraction[]
  documents    Document[]
  tasks        FinancialTask[]
  messages     OutboundMessage[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([entityId])
  @@index([assigneeUserId, status])
  @@index([resolutionDueAt])
  waConversations WaConversation[]
  @@map("tickets")
}

/// Histórico de interações do chamado: notas internas, respostas, ligações, visitas, reuniões (ata), mudanças.
model TicketInteraction {
  id              String   @id @default(uuid())
  ticketId        String
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  contactId       String?
  contact         Contact? @relation(fields: [contactId], references: [id])
  kind            String   @default("NOTE") // NOTE | REPLY | CALL | EMAIL | WHATSAPP | VISIT | MEETING | STATUS | ASSIGNMENT | SYSTEM
  direction       String   @default("INTERNAL") // INBOUND | OUTBOUND | INTERNAL
  body            String
  occurredAt      DateTime @default(now())
  durationMinutes Int?
  location        String?
  attendees       String?
  documentId      String?
  outboundMessageId String?
  createdAt       DateTime @default(now())

  @@index([ticketId, occurredAt])
  @@map("ticket_interactions")
}

/// Campanha de comunicação (WhatsApp/e-mail) para um público de entidades/contatos, reaproveitando modelos e provedores.
model Campaign {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  name            String
  channel         String // WHATSAPP | EMAIL
  templateKey     String?
  subject         String?
  body            String
  audience        Json
  status          String       @default("DRAFT") // DRAFT | RUNNING | DONE | CANCELLED
  scheduledAt     DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  recipients CampaignRecipient[]

  @@index([organizationId, status])
  @@map("campaigns")
}

model CampaignRecipient {
  id                String           @id @default(uuid())
  campaignId        String
  campaign          Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  entityId          String
  entity            Entity           @relation(fields: [entityId], references: [id])
  contactId         String?
  contact           Contact?         @relation(fields: [contactId], references: [id])
  recipient         String?
  status            String           @default("PENDING") // PENDING | SENT | MANUAL_PENDING | FAILED | SKIPPED
  outboundMessageId String?          @unique
  outboundMessage   OutboundMessage? @relation(fields: [outboundMessageId], references: [id])
  error             String?
  sentAt            DateTime?
  createdAt         DateTime         @default(now())

  @@unique([campaignId, entityId, contactId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

/// Fase 8 — Integrações externas: configuração por organização (segredos cifrados), estado, testes e circuit breaker.
model Integration {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  key              String // WHATSAPP | EMAIL | SIGNATURE | CNPJ | IBGE | PNCP | COMPRASGOV
  provider         String // whatsapp-cloud | smtp | clicksign | brasilapi | ibge | pncp | comprasgov | manual
  isEnabled        Boolean      @default(true)
  /// Parâmetros não sensíveis (ex.: apiUrl, from, phoneId, verifyToken)
  config           Json         @default("{}")
  /// Segredos cifrados (AES-256-GCM) — nunca devolvidos à interface
  secrets          Json         @default("{}")
  status           String       @default("NOT_CONFIGURED") // NOT_CONFIGURED | CONFIGURED | ERROR
  lastTestAt       DateTime?
  lastTestOk       Boolean?
  lastError        String?
  consecutiveFailures Int       @default(0)
  circuitOpenUntil DateTime?
  updatedByUserId  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, key])
  @@map("integrations")
}

/// Log de cada chamada externa (sem segredos), com tentativa, duração e resultado.
model IntegrationLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  integrationKey String
  provider       String
  action         String // SEND | TEST | FETCH | WEBHOOK_IN | WEBHOOK_OUT | STATUS
  status         String // OK | FAILED | SKIPPED | MANUAL
  attempt        Int          @default(1)
  durationMs     Int?
  request        Json?
  response       Json?
  error          String?
  referenceType  String?
  referenceId    String?
  idempotencyKey String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, integrationKey, createdAt])
  @@index([referenceType, referenceId])
  @@map("integration_logs")
}

/// Webhook de saída (assinatura HMAC-SHA256 no cabeçalho X-Siow-Signature) para eventos da plataforma.
model Webhook {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  name            String
  url             String
  /// Segredo cifrado usado na assinatura HMAC
  secret          String?
  events          Json         @default("[]")
  isActive        Boolean      @default(true)
  consecutiveFailures Int      @default(0)
  lastDeliveryAt  DateTime?
  lastStatus      String?
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  deliveries WebhookDelivery[]

  @@index([organizationId])
  @@map("webhooks")
}

model WebhookDelivery {
  id             String   @id @default(uuid())
  webhookId      String
  webhook        Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventId        String
  event          String
  payload        Json
  status         String   @default("PENDING") // PENDING | SENT | FAILED | CANCELLED
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  responseStatus Int?
  error          String?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())

  @@unique([webhookId, eventId])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

/// Central de atendimento WhatsApp (Fase 6b): uma conversa por número; janela de 24h; fila por atendente.
model WaConversation {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  waId               String // número (dígitos) do cliente
  displayName        String?
  contactId          String?
  contact            Contact?     @relation(fields: [contactId], references: [id])
  entityId           String?
  entity             Entity?      @relation(fields: [entityId], references: [id])
  ticketId           String?
  ticket             Ticket?      @relation(fields: [ticketId], references: [id])
  status             String       @default("OPEN") // OPEN | CLOSED
  assigneeUserId     String?
  assignee           User?        @relation("WaAssignee", fields: [assigneeUserId], references: [id])
  unreadCount        Int          @default(0)
  lastInboundAt      DateTime?
  lastOutboundAt     DateTime?
  lastMessageAt      DateTime     @default(now())
  lastMessagePreview String?
  closedAt           DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  messages WaMessage[]

  @@unique([organizationId, waId])
  @@index([organizationId, status, lastMessageAt])
  @@index([assigneeUserId, status])
  @@map("wa_conversations")
}

model WaMessage {
  id                String         @id @default(uuid())
  conversationId    String
  conversation      WaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         String // IN | OUT
  providerMessageId String?        @unique
  type              String         @default("text") // text | image | audio | video | document | sticker | location | template | unsupported
  body              String?
  mediaId           String?
  mediaMimeType     String?
  mediaFileName     String?
  documentId        String?
  status            String         @default("RECEIVED") // RECEIVED | QUEUED | SENT | DELIVERED | READ | FAILED
  error             String?
  userId            String?
  templateName      String?
  outboundMessageId String?
  timestamp         DateTime       @default(now())
  createdAt         DateTime       @default(now())

  @@index([conversationId, timestamp])
  @@map("wa_messages")
}

/// Fase 11 — limite de requisições compartilhado entre instâncias (janela fixa por chave).
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@map("rate_limits")
}
