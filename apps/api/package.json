{
  "name": "@siow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "build": "swc src -d dist --strip-leading-paths --config-file ../../.swcrc",
    "start": "node --enable-source-maps --import @swc-node/register/esm-register dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.720.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.3.0",
    "@siow/db": "workspace:*",
    "@siow/integrations": "workspace:*",
    "@siow/queue": "workspace:*",
    "@siow/shared": "workspace:*",
    "@siow/storage": "workspace:*",
    "@siow/sync-core": "workspace:*",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.2",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@swc-node/register": "^1.10.9",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.10.4",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.8",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
