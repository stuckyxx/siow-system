# =====================================================================
#  Variáveis de ambiente do deploy na Vercel (Project → Settings → Environment Variables)
#  Copie cada linha abaixo como uma variável. Linhas com "#" são comentários.
#  Guia passo a passo: docs/DEPLOY-VERCEL.md
# =====================================================================

# ---------- Banco de dados (Neon) ----------
# Connection string POOLED do Neon (host termina em "-pooler.<região>.aws.neon.tech").
# Usada pela aplicação em runtime (serverless). Mantenha sslmode=require e pgbouncer=true.
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
# Connection string DIRETA do Neon (sem "-pooler"). Usada só por `prisma db push` / migrations.
DIRECT_URL=postgresql://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# ---------- Segredos (gere valores aleatórios; mínimo 32 caracteres) ----------
# Dica: https://generate-secret.vercel.app/48  ou  `openssl rand -base64 48`
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_REFRESH_SECRET=troque-por-outro-segredo-aleatorio-com-pelo-menos-32-caracteres
# Protege /api/cron/* e /api/admin/bootstrap (header "Authorization: Bearer <CRON_SECRET>").
# A Vercel envia este valor automaticamente nos crons se a variável se chamar exatamente CRON_SECRET.
CRON_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-16-caracteres

# ---------- Armazenamento de documentos (Vercel Blob) ----------
# Criado automaticamente ao conectar um Blob Store ao projeto (Storage → Blob → Connect).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Comportamento ----------
# Cookies só por HTTPS (sempre "true" na Vercel).
COOKIE_SECURE=true
# Orçamento de tempo (ms) de cada chamada de sincronização em lote (/api/cron/sync, "Sincronizar todas").
# Hobby: funções de até 60 s → 45000 é seguro. Pro (até 300 s): pode subir para 240000.
SYNC_BUDGET_MS=45000
# Quantas fontes sincronizar em paralelo (1–5).
SYNC_CONCURRENCY=2
# URL pública do app (opcional; usada em links de notificações/e-mails).
# APP_URL=https://seu-app.vercel.app

# ---------- Administrador inicial (usado por POST /api/admin/bootstrap) ----------
SEED_ADMIN_EMAIL=admin@suaempresa.com.br
SEED_ADMIN_NAME=Administrador
# Mínimo 12 caracteres. O sistema exige a troca no primeiro login.
SEED_ADMIN_PASSWORD=TroqueEstaSenha!2026

# ---------- Mensageria (opcional — sem isso, as mensagens ficam em modo "envio manual") ----------
# SMTP_HOST=smtp.seuprovedor.com.br
# SMTP_PORT=587
# SMTP_USER=financeiro@suaempresa.com.br
# SMTP_PASS=
# SMTP_FROM=Financeiro <financeiro@suaempresa.com.br>
# WHATSAPP_API_URL=https://graph.facebook.com/v19.0
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=

# NÃO defina NEXT_PUBLIC_API_URL na Vercel: a API roda no mesmo deploy (/api/*).
